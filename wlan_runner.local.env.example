# Copy this file to wlan_runner.local.env on each PC.
# WLAN Runner reads it at startup. Do not commit the real file.

ARTIFACTORY_USERNAME=wifi_sqa_user
ARTIFACTORY_PASSWORD=

# Written into settings_defaults.env before a run. Do not commit the real token.
VAULT_TOKEN=

# Optional Raspberry Pi login. Used when a setup does not set pi_user / pi_password.
# Defaults are pi / raspberry when both are empty.
RASPI_USERNAME=
RASPI_PASSWORD=

# Optional seconds to wait after a Raspberry Pi reboot. Default is 30.
# RASPI_REBOOT_WAIT=30

# Optional folder of the SoC commander.exe when it is not in
# SoC_Secure\Simplicity Commander. The keys (SoC_Secure\keys) and the secure
# script stay in SoC_Secure.
# SOC_COMMANDER_FOLDER=C:\path\to\Simplicity Commander
